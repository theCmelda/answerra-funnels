{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "buildCommand": null,
  "outputDirectory": ".",
  "installCommand": null,
  "framework": null,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {"key": "X-Frame-Options", "value": "SAMEORIGIN"},
        {"key": "X-Content-Type-Options", "value": "nosniff"},
        {"key": "Referrer-Policy", "value": "strict-origin-when-cross-origin"},
        {"key": "Cache-Control", "value": "public, max-age=300, s-maxage=600"}
      ]
    }
  ],
  "redirects": [
    {"source": "/dental", "destination": "/funnel-dental-01-two-kinds", "permanent": false},
    {"source": "/medspa", "destination": "/funnel-medspa-01-1500-lapsed", "permanent": false},
    {"source": "/plumbing", "destination": "/funnel-plumbing-01-phone-cant-answer", "permanent": false}
  ]
}
